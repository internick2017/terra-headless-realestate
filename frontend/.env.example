# WordPress GraphQL endpoint. The local dev stack lives in wp-plugin/dev.
WP_GRAPHQL_URL=http://localhost:8930/graphql

# Optional. Template for the static map image on property detail pages, with
# {lat} {lon} {zoom} {width} {height} placeholders. Unset, it falls back to a
# keyless OpenStreetMap service that is fine for local work but makes no uptime
# promise — production should point this at a provider it pays for.
# NEXT_PUBLIC_STATIC_MAP_URL=https://maps.geoapify.com/v1/staticmap?style=osm-bright&center=lonlat:{lon},{lat}&zoom={zoom}&width={width}&height={height}&marker=lonlat:{lon},{lat};color:%23336699&apiKey=YOUR_KEY
